#!/usr/bin/env python3
"""Replaces the databases of a couchdb service with the dump read from stdin.

An import replaces: each database in the dump is deleted and remade before its
documents are written, so what is read back afterwards is what was in the dump
and nothing that happened to be there before. Databases the dump does not name
are left alone.

The database the dump names as its service's own is written to this service's
own database, whatever either is called, so a dump moves between services. The
others keep their names. A dump with only "docs" at the top, from before the
export covered every database, is the service's own.
"""
import base64
import json
import os
import sys
import urllib.error
import urllib.request

HOST = os.environ.get("COUCHDB_HOST", "127.0.0.1")
PORT = os.environ.get("COUCHDB_PORT", "5984")
DATABASE = os.environ["COUCHDB_DATABASE"]
USER = os.environ["COUCHDB_USER"]
PASSWORD = os.environ["COUCHDB_PASSWORD"]


def request(path, method="GET", body=None):
    url = "http://{}:{}/{}".format(HOST, PORT, path)
    credentials = base64.b64encode("{}:{}".format(USER, PASSWORD).encode()).decode()
    headers = {"Authorization": "Basic " + credentials, "Content-Type": "application/json"}
    payload = json.dumps(body).encode() if body is not None else None
    message = urllib.request.Request(url, data=payload, headers=headers, method=method)

    with urllib.request.urlopen(message) as response:
        return json.load(response)


def replace(database, documents):
    # a revision belongs to the database the document came from, and offering
    # one to a database that has never seen the document is refused
    for document in documents:
        document.pop("_rev", None)

    try:
        request(database, method="DELETE")
    except urllib.error.HTTPError as error:
        if error.code != 404:
            sys.stderr.write("unable to remove {}: {}\n".format(database, error))
            return 1

    request(database, method="PUT")

    if not documents:
        return 0

    written = request("{}/_bulk_docs".format(database), method="POST", body={"docs": documents})
    for result in written:
        if result.get("error"):
            sys.stderr.write("unable to write {}/{}: {}\n".format(database, result.get("id"), result))
            return 1

    return 0


def main():
    dump = json.load(sys.stdin)

    if "databases" not in dump:
        return replace(DATABASE, dump.get("docs", []))

    for name, content in dump["databases"].items():
        if name == dump.get("database"):
            name = DATABASE
        status = replace(name, content.get("docs", []))
        if status:
            return status

    return 0


if __name__ == "__main__":
    sys.exit(main())
